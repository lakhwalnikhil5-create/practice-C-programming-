#include <stdio.h>

int main()
{
    int phy, chem, bio, math, comp;
    float per;

    printf("Enter five subject marks: ");
    scanf("%d%d%d%d%d", &phy, &chem, &bio, &math, &comp);

    per = (phy + chem + bio + math + comp) / 5.0;

    printf("Percentage = %.2f\n", per);

    if(per >= 80)
    {
        printf("Grade A");
    }
    else if(per >= 60)
    {
        printf("Grade B");
    }
    else if(per >= 40)
    {
        printf("Grade C");
    }
    else
    {
        printf("FAIL");
    }

    return 0;
}
